{
  "redirects": [
    {
      "source": "/work/wordpress-website",
      "destination": "/work/jst-group/",
      "permanent": true
    },
    {
      "source": "/work/wordpress-website/:path*",
      "destination": "/work/jst-group/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path+/index.html",
      "destination": "/:path+/",
      "permanent": true
    }
  ]
}
